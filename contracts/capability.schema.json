{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchapp.local/contracts/capability.schema.json",
  "title": "WatchApp runtime capability snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentType", "schemaVersion", "snapshotVersion", "capturedAt", "deviceId", "capabilities"],
  "properties": {
    "documentType": { "const": "capability_snapshot" },
    "schemaVersion": { "const": 1 },
    "snapshotVersion": { "$ref": "#/$defs/uint64String" },
    "capturedAt": { "$ref": "#/$defs/instant" },
    "deviceId": { "$ref": "#/$defs/deviceId" },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "modes", "source"],
        "properties": {
          "id": { "enum": ["heart_rate", "ibi", "steps", "distance", "active_energy", "workout", "oxygen_saturation", "skin_temperature", "body_composition", "ecg", "ppg_green", "ppg_red_ir", "accelerometer", "battery", "notification_lab"] },
          "state": { "enum": ["available", "permission_blocked", "approval_blocked", "temporarily_unavailable", "unsupported"] },
          "modes": { "type": "array", "uniqueItems": true, "maxItems": 5, "items": { "enum": ["passive", "live", "spot", "workout", "raw_session"] } },
          "source": { "enum": ["wear_health_services", "samsung_sensor_sdk", "platform", "experimental"] },
          "reasonCode": { "enum": ["permission_required", "partner_approval_required", "watch_not_worn", "sensor_busy", "policy_restricted", "firmware_unsupported", "bluetooth_unavailable", "ancs_unavailable", "unknown"] }
        }
      }
    }
  },
  "$defs": {
    "deviceId": { "type": "string", "pattern": "^wa_[A-Za-z0-9_-]{22,64}$" },
    "uint64String": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "instant": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
